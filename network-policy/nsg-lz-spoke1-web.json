{
  "nsgName": "nsg-lz-spoke1-web",
  "description": "Web tier subnet (spoke1)",
  "rules": [
    {
      "name": "Allow-AzureLoadBalancer-Inbound",
      "priority": 1000,
      "direction": "Inbound",
      "access": "Allow",
      "protocol": "*",
      "source": "AzureLoadBalancer",
      "sourceAsg": "",
      "destination": "*",
      "destinationAsg": "",
      "ports": [
        "*"
      ],
      "description": "Platform health probes. Needed because of the explicit deny at 4000."
    },
    {
      "name": "Allow-HTTPS-Corp-To-Web",
      "priority": 2000,
      "direction": "Inbound",
      "access": "Allow",
      "protocol": "Tcp",
      "source": "172.16.0.0/12",
      "sourceAsg": "",
      "destination": "",
      "destinationAsg": "asg-lz-web",
      "ports": [
        "443"
      ],
      "description": "Fictional corporate network to web servers over HTTPS."
    },
    {
      "name": "Deny-All-Inbound",
      "priority": 4000,
      "direction": "Inbound",
      "access": "Deny",
      "protocol": "*",
      "source": "*",
      "sourceAsg": "",
      "destination": "*",
      "destinationAsg": "",
      "ports": [
        "*"
      ],
      "description": "Overrides the default AllowVnetInBound (65000)."
    }
  ]
}

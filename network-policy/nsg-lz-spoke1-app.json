{
  "nsgName": "nsg-lz-spoke1-app",
  "description": "App tier subnet (spoke1)",
  "rules": [
    {
      "name": "Allow-AzureLoadBalancer-Inbound",
      "priority": 1000,
      "direction": "Inbound",
      "access": "Allow",
      "protocol": "*",
      "source": "AzureLoadBalancer",
      "sourceAsg": "",
      "destination": "*",
      "destinationAsg": "",
      "ports": [
        "*"
      ],
      "description": "Platform health probes. Needed because of the explicit deny at 4000."
    },
    {
      "name": "Allow-Web-To-App-8080",
      "priority": 2000,
      "direction": "Inbound",
      "access": "Allow",
      "protocol": "Tcp",
      "source": "",
      "sourceAsg": "asg-lz-web",
      "destination": "",
      "destinationAsg": "asg-lz-app",
      "ports": [
        "8443"
      ],
      "description": "Web servers to app servers (same VNet, so ASGs work)."
    },
    {
      "name": "Deny-All-Inbound",
      "priority": 4000,
      "direction": "Inbound",
      "access": "Deny",
      "protocol": "*",
      "source": "*",
      "sourceAsg": "",
      "destination": "*",
      "destinationAsg": "",
      "ports": [
        "*"
      ],
      "description": "Overrides the default AllowVnetInBound (65000)."
    }
  ]
}
